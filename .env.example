# =====================================================================
# GeoPulse Environment Configuration Example
# Copy this file to .env before running: cp .env.example .env
# =====================================================================

# Server Ports
PORT=50051
METRICS_PORT=2112

# PostgreSQL + PostGIS Credentials
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=geopulse
POSTGRES_PASSWORD=geopulse_secret
POSTGRES_DB=geopulse
POSTGRES_SSLMODE=disable

# Redis Hot Path Settings
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
STALE_THRESHOLD=30s
SWEEP_INTERVAL=5s

# Cold Path Batch Persistence Settings
BATCH_SIZE=250
BATCH_INTERVAL=3s
BULK_MODE=copy
