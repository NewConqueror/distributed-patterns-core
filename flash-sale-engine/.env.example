# Server Configuration
PORT=8080

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=flashsale
DB_SSLMODE=disable

# Optional: Full Database URL (overrides individual DB_* fields if set)
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/flashsale?sslmode=disable

# Connection Pool Settings (Set 0 for unlimited to reproduce pool exhaustion)
DB_MAX_OPEN_CONNS=0
DB_MAX_IDLE_CONNS=10

# Redis Configuration (For future distributed lock implementations)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
