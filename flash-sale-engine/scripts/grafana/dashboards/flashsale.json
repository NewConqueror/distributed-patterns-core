{
  "annotations": {
    "list": []
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": true,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "id": 1,
      "title": "Throughput (RPS by Endpoint & Status)",
      "type": "timeseries",
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "sum by (endpoint, status) (rate(flashsale_http_requests_total[5s]))",
          "legendFormat": "{{endpoint}} ({{status}})",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 15
          },
          "unit": "reqps"
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "id": 2,
      "title": "Latency Distribution (P95 / P99 / Median)",
      "type": "timeseries",
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "histogram_quantile(0.99, sum by (le, endpoint) (rate(flashsale_http_request_duration_seconds_bucket[10s])))",
          "legendFormat": "{{endpoint}} - P99",
          "refId": "A"
        },
        {
          "datasource": "Prometheus",
          "expr": "histogram_quantile(0.95, sum by (le, endpoint) (rate(flashsale_http_request_duration_seconds_bucket[10s])))",
          "legendFormat": "{{endpoint}} - P95",
          "refId": "B"
        },
        {
          "datasource": "Prometheus",
          "expr": "histogram_quantile(0.50, sum by (le, endpoint) (rate(flashsale_http_request_duration_seconds_bucket[10s])))",
          "legendFormat": "{{endpoint}} - P50 (Median)",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2
          },
          "unit": "s"
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "id": 3,
      "title": "PostgreSQL Connection Pool Contention",
      "type": "timeseries",
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "flashsale_db_pool_open_connections",
          "legendFormat": "Open Connections",
          "refId": "A"
        },
        {
          "datasource": "Prometheus",
          "expr": "flashsale_db_pool_in_use_connections",
          "legendFormat": "Active / In-Use Connections",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 20
          },
          "unit": "short"
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "id": 4,
      "title": "Inventory Depletion Curve & Stock Level",
      "type": "timeseries",
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "flashsale_product_stock",
          "legendFormat": "Stock (Product {{product_id}} - {{tier}})",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "stepAfter",
            "lineWidth": 3,
            "fillOpacity": 10
          },
          "unit": "short"
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 16 },
      "id": 5,
      "title": "Message Queue / Consumer Lag",
      "type": "timeseries",
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "flashsale_kafka_consumer_lag",
          "legendFormat": "Consumer Lag (Pending Reservations)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 15
          },
          "unit": "short"
        }
      }
    }
  ],
  "refresh": "1s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["flash-sale", "concurrency", "distributed-locking"],
  "time": {
    "from": "now-5m",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": ["1s", "5s", "10s"]
  },
  "timezone": "browser",
